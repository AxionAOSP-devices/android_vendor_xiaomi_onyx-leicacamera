binder_call(hal_camera_default, platform_app)
allow hal_camera_default hal_misys_vendor_exec:file entrypoint;
allow hal_camera_default hal_misys_vendor_service:service_manager add;
allow hal_camera_default vendor_camera_data_file:dir { create_dir_perms r_dir_perms };
allow hal_camera_default vendor_camera_data_file:file { create_file_perms rw_file_perms };
allow hal_camera_default appdomain_tmpfs:file rw_file_perms;

# HEIC capture: the HEIF muxer (libheichal) writes the container into a memfd, which a non-app domain labels plain tmpfs instead of appdomain_tmpfs, so MPEG4Writer hits EACCES and leaves a 21 MB all-zero .HEIC.
allow hal_camera_default tmpfs:file rw_file_perms;

# HEIF brand/model metadata read by the muxer
get_prop(hal_camera_default, media_config_prop);

# GPU clock info queried by the algo framework
allow hal_camera_default vendor_sysfs_kgsl:file r_file_perms;
