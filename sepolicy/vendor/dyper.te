# Rules harvested from real enforcing-mode avc denials on the POCO F7 (onyx); both platform_app (ROM build, platform key) and priv_app (testkey-signed KernelSU/ADB user update) are covered.

# platform_app: the capture handoff is bidirectional - the app registers a callback with the HAL (MiCamService BGService) and the provider calls back into it; missing the callback transfer stalls PostProcessor 12s on 'App buffer is not enough' -> onCaptureFailed.
allow platform_app hal_camera_default:binder { call transfer };
allow platform_app hal_camera_default:fd { use };
allow hal_camera_default platform_app:binder { call transfer };
allow hal_camera_default platform_app:fd { use };

# The app-side c2-store find needs no rule here: labelling vendor0_software as hal_codec2_service in service_contexts puts it under the platform hal_codec2_client attribute, which already covers every non-isolated app domain.

# The watermark / filter assets under /data/vendor/camera are mmap'd, not just read
allow platform_app vendor_camera_data_file:file { getattr open read map };

# ------------------------------------------------------------------- priv_app
allow priv_app hal_camera_default:binder { call transfer };
allow hal_camera_default priv_app:binder { call transfer };
allow priv_app hal_misys_vendor_service:service_manager find;
allow priv_app hal_aidlbgservice_service:service_manager find;
allow priv_app vendor_camera_data_file:dir { search open read };
allow priv_app vendor_camera_data_file:file { getattr open read map };

allow priv_app proc_pressure_cpu:file { getattr open read };
allow priv_app proc_pressure_mem:file { getattr open read };
allow priv_app proc_pressure_io:file { getattr open read };

get_prop(priv_app, vendor_camera_p3enable_prop)
get_prop(priv_app, vendor_camera_sensor_prop)
get_prop(priv_app, vendor_audio_prop)
get_prop(priv_app, vendor_displayfeature_prop)

binder_call(priv_app, hal_misys_vendor)
binder_call(hal_misys_vendor, priv_app)

# QSPM service find is reserved for qspmhal clients by qcom's own neverallow (device/qcom/sepolicy_vndr/.../qspmhal.te:40); only the binder rule is legal.
allow hal_camera_default vendor_hal_qspmhal_default:binder call;

# panel_build_id / displayfeature sysfs nodes read per frame
allow hal_camera_default vendor_sysfs_displayfeature:dir search;
allow hal_camera_default vendor_sysfs_displayfeature:file { getattr open read };

allow hal_camera_default sysfs:file { getattr open read };

# traversing the app data dir for the snapshot handoff (shell_data_file is neverallowed to any non-shell domain)
allow hal_camera_default system_data_file:dir search;

# codec2: the Xiaomi store (audiocommon/ccode2) registers IComponentStore/vendor0_software from the mediacodec process - without it video recording never starts. mediaserver and mediaswcodec need nothing: the platform already grants hal_codec2_client the find.
allow mediacodec hal_codec2_service:service_manager add;
allow mediacodec hal_codec2_service:service_manager find;
